# Local simulation: optional token; never commit actual values.
LAB_STATE_BACKEND=local
LAB_STATE_DIR=.lab/web
# LAB_API_TOKEN=<set securely, at least 32 characters for cloud>

# Future Vercel plan: full Atlas durable storage/semantic parity is still needed.
