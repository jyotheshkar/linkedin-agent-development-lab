{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:linkedin-atlas-l1-lab:progress:1",
  "title": "L1 practice checkpoint version 1",
  "type": "object",
  "required": ["schema_version", "created_at", "concepts", "attempts", "metrics", "next_action", "source_ids", "reference_exposure"],
  "properties": {
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "concepts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}},
    "metrics": {"type": "object"},
    "next_action": {"type": "string"},
    "source_ids": {"type": "array", "items": {"type": "string"}},
    "reference_exposure": {"type": "array", "items": {"type": "object"}}
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "required": ["question_id", "variant_id", "topic"],
      "allOf": [
        {
          "if": {
            "required": ["rubric"],
            "properties": {"rubric": {"type": "object"}},
            "not": {"required": ["graded"], "properties": {"graded": {"const": false}}}
          },
          "then": {"required": ["assisted"]}
        }
      ],
      "properties": {
        "attempt_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "minLength": 1},
        "variant_id": {"type": "string", "minLength": 1},
        "topic": {"type": "string", "minLength": 1},
        "graded": {"type": "boolean"},
        "rubric": {
          "type": ["object", "null"],
          "required": ["correctness", "reasoning", "boundaries", "explanation"],
          "properties": {
            "correctness": {"type": "number", "minimum": 0, "maximum": 4},
            "reasoning": {"type": "number", "minimum": 0, "maximum": 2},
            "boundaries": {"type": "number", "minimum": 0, "maximum": 2},
            "explanation": {"type": "number", "minimum": 0, "maximum": 2}
          },
          "additionalProperties": false
        },
        "assisted": {"type": "boolean"},
        "assistance": {"type": "boolean", "description": "Legacy disqualifying flag; does not replace required assisted declaration."},
        "hints": {"type": ["array", "boolean"], "items": {"type": "string"}},
        "reference_exposed": {"type": "boolean"},
        "copied_reference": {"type": "boolean"},
        "is_transfer": {"type": "boolean"},
        "critical_misconception": {"type": "boolean"},
        "test_evidence": {"type": "array", "items": {"type": "object"}},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "next_action": {"type": "string"}
      }
    }
  }
}
