{
  "name": "LinkedIn Agent Development Lab (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "L1 local API", "onAutoForward": "notify", "visibility": "private"}},
  "customizations": {"vscode": {"extensions": ["ms-python.python"], "settings": {"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"}}},
  "remoteUser": "vscode"
}
